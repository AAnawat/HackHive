NODE_ENV= #"development" or "production"

# If NODE_ENV is "production", Only the following variables need to be set
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USER=
DB_PASS=

AWS_REGION=

JWT_SECRET=
ADMIN_TOKEN=

# If NODE_ENV is "development", the following variables need to be set
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=


# "local" runs problems on local Docker and stores pictures in ./uploads (no AWS needed)
# docker-compose sets CLOUD_PROVIDER and DB_* for you from the root .env
CLOUD_PROVIDER=
# Optional overrides for CLOUD_PROVIDER=local
DOCKER_SOCKET=
DOCKER_PUBLIC_HOST=
PUBLIC_API_URL=

FROM aunanawat/hackhive-baseimage:v1

WORKDIR /server

ENV FLAG="example_flag"

ARG SCRIPT=getting-start.sh

COPY ./scripts/${SCRIPT} ./

# Strip CRLF line endings from Windows checkouts
RUN sed -i 's/\r$//' ${SCRIPT} && chmod +x ${SCRIPT}

ENV SCRIPT=${SCRIPT}

RUN ls -la

CMD [ "bash", "-c", "./$SCRIPT" ]